// Forex Scalping V2 Trading System - Prisma Schema
// SQLite database for trade journal, signals, news, settings

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Trading account info (cached from MT5)
model Account {
  id              String   @id @default(cuid())
  login           Int      @unique
  server          String
  broker          String   @default("Finex Indonesia")
  currency        String   @default("USD")
  leverage        Int      @default(100)
  balance         Float
  equity          Float
  margin          Float    @default(0)
  marginFree      Float    @default(0)
  marginLevel     Float    @default(0)
  profit          Float    @default(0)
  lastSync        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Open & historical trades
model Trade {
  id              String   @id @default(cuid())
  ticket          Int      @unique // MT5 ticket
  symbol          String
  direction       String   // BUY | SELL
  volume          Float    // lot size
  openPrice       Float
  closePrice      Float?
  sl              Float
  tp1             Float
  tp2             Float?
  slPips          Float
  tp1Pips         Float
  rrNet           Float    // risk:reward net setelah biaya
  atrValue        Float    // ATR saat entry
  adxValue        Float    // ADX saat entry
  regime          String   // TRENDING | TRANSITION | RANGING
  setupType       String   // VWAP_BOUNCE | EMA_CROSS | PIN_BAR | ENGULFING | INSIDE_BAR
  session         String   // TOKYO | LONDON | OVERLAP
  status          String   @default("OPEN") // OPEN | CLOSED | PENDING
  result          String?  // WIN | LOSS | BREAKEVEN
  rMultiple       Float?   // R net result
  profitNet       Float?   // profit USD net
  closeReason     String?  // TP1 | TP2 | SL | TRAILING | MANUAL | INVALID
  entryTime       DateTime @default(now())
  closeTime       DateTime?
  durationMin     Int?
  checklistJson   String   // JSON: 8-point V2 checklist
  aiAnalysis      String?  // Ollama analysis at entry
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([symbol])
  @@index([status])
  @@index([entryTime])
}

// Trading signals generated by V2 strategy engine
model Signal {
  id              String   @id @default(cuid())
  symbol          String
  direction       String   // BUY | SELL
  timeframe       String   @default("M5")
  entryPrice      Float
  slPrice         Float
  tp1Price        Float
  tp2Price        Float
  slPips          Float
  rrNet           Float
  atrValue        Float
  adxValue        Float
  vwapValue       Float
  ema9Value       Float
  ema21Value      Float
  regime          String
  setupType       String
  session         String
  checklistPassed Int      @default(8) // dari 8 poin V2
  status          String   @default("ACTIVE") // ACTIVE | EXECUTED | EXPIRED | SKIPPED
  reason          String?  // skip reason bila ada
  aiVerdict       String?  // AI compliance verdict
  createdAt       DateTime @default(now())
  expiresAt       DateTime?

  @@index([symbol])
  @@index([status])
  @@index([createdAt])
}

// Economic calendar events from Tiingo
model NewsEvent {
  id              String   @id @default(cuid())
  ticker          String   // EUR, USD, etc
  title           String
  impact          String   // HIGH | MEDIUM | LOW
  country         String
  currency        String
  eventTime       DateTime
  actual          String?
  forecast        String?
  previous        String?
  source          String   @default("tiingo")
  blackoutStart   DateTime?
  blackoutEnd     DateTime?
  fetchedAt       DateTime @default(now())

  @@index([eventTime])
  @@index([impact])
}

// V2 strategy configuration settings
model Setting {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String
  category        String   @default("general")
  updatedAt       DateTime @updatedAt
}

// Daily risk tracker (tiered stop)
model DailyRisk {
  id              String   @id @default(cuid())
  date            String   @unique // YYYY-MM-DD
  startingBalance Float
  currentBalance  Float
  dailyPnl        Float    @default(0)
  dailyPnlPct     Float    @default(0)
  tradesCount     Int      @default(0)
  winsCount       Int      @default(0)
  lossesCount     Int      @default(0)
  softStopHit     Boolean  @default(false) // -1%
  hardStopHit     Boolean  @default(false) // -2%
  botLocked       Boolean  @default(false)
  lockReason      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Weekly summary for PDF export
model WeeklySummary {
  id                String   @id @default(cuid())
  weekStart         String   @unique // YYYY-MM-DD
  weekEnd           String
  totalTrades       Int      @default(0)
  totalWins         Int      @default(0)
  totalLosses       Int      @default(0)
  winRate           Float    @default(0)
  rNetTotal         Float    @default(0)
  profitNet         Float    @default(0)
  profitFactor      Float    @default(0)
  maxDrawdown       Float    @default(0)
  checklistCompliance Float  @default(0)
  mondayJson        String   // JSON data per day
  createdAt         DateTime @default(now())
}

// Bot control state
model BotState {
  id              String   @id @default(cuid())
  name            String   @unique @default("main")
  status          String   @default("STOPPED") // RUNNING | STOPPED | PAUSED | KILLED
  autoTrade       Boolean  @default(true)
  killSwitch      Boolean  @default(false)
  lastStartedAt   DateTime?
  lastStoppedAt   DateTime?
  totalTrades     Int      @default(0)
  totalWins       Int      @default(0)
  totalLosses     Int      @default(0)
  uptimeSec       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// AI Chat conversation with Ollama
model ChatMessage {
  id              String   @id @default(cuid())
  role            String   // user | assistant | system
  content         String
  context         String?  // strategy | pair | trade | general
  model           String   @default("llama3.2:latest")
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

// Price & indicator alerts (Frontend-100 Feature 5)
// Created by operators via the Alerts view; evaluated by the backend
// against live tick data and indicator values. When triggered, the backend
// emits an `alert_triggered` WebSocket event and (optionally) sends a
// browser push + Telegram notification.
model PriceAlert {
  id              String    @id @default(cuid())
  // PRICE_ABOVE | PRICE_BELOW | ADX_CROSS_UP | ADX_CROSS_DOWN |
  // RSI_OVERBOUGHT | RSI_OVERSOLD | SPREAD_WIDE
  type            String
  symbol          String
  threshold       Float
  // BROWSER | TELEGRAM | BOTH
  notifyMethod    String    @default("BOTH")
  active          Boolean   @default(true)
  note            String?
  lastTriggered   DateTime?
  triggerCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([symbol])
  @@index([active])
  @@index([type])
}
