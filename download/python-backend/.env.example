# ============================================================ #
# Forex Scalping Backend - .env template
# Copy this file to `.env` and fill in your real values.
# All values are read by config.py at startup.
# ============================================================ #

# ---- MetaTrader 5 (Finex Indonesia broker) ----
# Numeric account login (Finex Indonesia MT5 account)
MT5_LOGIN=12345678
# Account password (or investor password for read-only)
MT5_PASSWORD=your_password_here
# Server name as shown in the MT5 terminal login dialog.
# Finex Indonesia typical servers:
#   - FinexECN-MT5-Demo   (demo)
#   - FinexECN-MT5-Live   (live)
MT5_SERVER=FinexECN-MT5-Demo
# Optional: full path to the MT5 terminal64.exe
# e.g. C:\Program Files\Finex Indonesia MetaTrader 5\terminal64.exe
MT5_TERMINAL_PATH=
# Connection timeout (ms) and retry settings
MT5_TIMEOUT_MS=60000
MT5_RETRY_ATTEMPTS=5
MT5_RETRY_DELAY_S=2.0

# ---- Ollama (local LLM) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT_S=120.0
OLLAMA_TEMPERATURE=0.3

# ---- Tiingo (economic calendar) ----
# Get a free token at https://api.tiingo.com/
TIINGO_API_KEY=
TIINGO_BASE_URL=https://api.tiingo.com
TIINGO_CACHE_TTL_S=3600

# ---- Risk (V2 strategy defaults - usually do not change) ----
# Override only if you know what you are doing.
# RISK_PCT_PER_TRADE=0.01
# MAX_POSITIONS=3
# MAX_DAILY_TRADES=5

# ---- Pairs to monitor ----
# Comma-separated, slash is optional
PAIRS=EURUSD,GBPUSD,USDJPY
# MT5 symbol names (default = same as PAIRS)
MT5_SYMBOLS=EURUSD,GBPUSD,USDJPY

# ---- Timezone ----
TIMEZONE=Asia/Jakarta

# ---- Server ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# Comma-separated CORS origins for the Next.js frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WS_HEARTBEAT_S=15.0

# ---- Logging ----
LOG_LEVEL=INFO
# Paths default to <backend dir>/data and <backend dir>/logs
# APP_BASE_DIR=
# DB_PATH=
# LOG_PATH=

# ---- Optional broker commissions (in pips per round turn) ----
# Used by the strategy engine for RR Net calc.  Adjust to match your ECN plan.
# commission_pips=0.7

# ---- Audit-fix Sprint 1: Order / slippage config ----
# Max slippage (deviation in points) accepted on new entries (default 20).
MAX_SLIPPAGE_POINTS=20
# Timeout (seconds) wrapping place_order / modify / close (default 30).
ORDER_TIMEOUT_SECONDS=30
# Retry attempts if the broker rejects on slippage (default 2).
SLIPPAGE_RETRY_ATTEMPTS=2
# Candle cache TTL (seconds) for MT5 copy_rates_* (default 60).
CANDLE_CACHE_TTL_S=60

# ---- Audit-fix Sprint 2: Paper / dry-run / weekend ----
# Paper mode = simulate trades in DB without calling place_order.
PAPER_MODE=false
# Dry-run = generate signals + events but never place orders (and no sim P&L).
DRY_RUN=false
# Friday weekend position closer - HH:MM WIB (default 21:30).
WEEKEND_CLOSE_TIME=21:30

# ---- Audit-fix Sprint 4: Telegram notifications (optional) ----
# Create a bot via @BotFather and chat ID via @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================ #
# Sprint 5 #1: API Authentication (Bearer token middleware)
# ============================================================ #
# Comma-separated list of valid API keys.  Empty = AUTH DISABLED
# (WARNING logged; only use for localhost dev mode).
# Generate with: python -c "import secrets; print('sk_'+secrets.token_hex(32))"
API_KEYS=

# ============================================================ #
# Sprint 5 #2: Encryption at Rest (SQLCipher)
# ============================================================ #
# 32-byte hex key for SQLCipher PRAGMA key.  Empty = plaintext SQLite.
# Generate with: python generate_key.py db
DB_ENCRYPTION_KEY=

# ============================================================ #
# Sprint 5 #3: Secrets Management (Fernet master key)
# ============================================================ #
# 44-char URL-safe base64 key for the secrets.SecretManager.
# Generate with: python generate_key.py secrets
SECRETS_MASTER_KEY=

# ============================================================ #
# Sprint 5 #5: HTTPS / TLS enforcement
# ============================================================ #
# When true, the FastAPI HTTPSRedirectMiddleware redirects HTTP -> HTTPS.
# Default false for dev.  In production, terminate TLS at Caddy/nginx.
ENFORCE_HTTPS=false

# ============================================================ #
# Sprint 5 #6: NextAuth integration (default admin user)
# ============================================================ #
# Password for the default admin user created on first run.
# If empty, a random password is generated and logged (recover from logs).
ADMIN_PASSWORD=

# ============================================================ #
# Sprint 7 #16: Position sizing mode
# ============================================================ #
# "fixed" (default, 1% per trade) or "kelly" (quarter-Kelly, capped at 2%).
POSITION_SIZING_MODE=fixed

# ============================================================ #
# BACKEND-100 (Sprint 9) #1: Multi-broker failover
# ============================================================ #
# Optional secondary MT5 broker credentials.  When all three are set the
# MT5ConnectorPool will fail over to this broker after the primary drops
# and exceeds MT5_FAILOVER_RETRY_THRESHOLD reconnect attempts.
MT5_LOGIN_2=
MT5_PASSWORD_2=
MT5_SERVER_2=
# Optional: terminal path for the secondary broker
MT5_TERMINAL_PATH_2=
# Number of primary reconnect attempts before failover (default 3).
MT5_FAILOVER_RETRY_THRESHOLD=3

# ============================================================ #
# BACKEND-100 (Sprint 9) #15: AWS S3 offsite backup
# ============================================================ #
# All optional.  Leave AWS_S3_BUCKET empty to disable S3 upload
# (POST /api/backup then returns only the local encrypted file).
AWS_S3_BUCKET=
AWS_S3_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================================ #
# BACKEND-100 (Sprint 9) #14: Alembic migration database URL
# ============================================================ #
# Override only if you use a non-SQLite backend (e.g. PostgreSQL).
# Default: sqlite:///<DB_PATH>
# ALEMBIC_DATABASE_URL=sqlite:////opt/forex-scalping-v2/python-backend/data/trading.db
