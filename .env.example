# Environment variables for Next.js frontend
# Copy this file to .env and fill in the values

# Database URL for Prisma (SQLite)
# Use relative path — works on both Windows and Linux
DATABASE_URL=file:./db/custom.db

# Python FastAPI backend URL (set this to enable production mode)
# When empty, dashboard runs in DEMO MODE with simulated data
NEXT_PUBLIC_PYTHON_API_URL=http://localhost:8000

# Optional: Python backend WebSocket URL for real-time updates
# NEXT_PUBLIC_PYTHON_WS_URL=ws://localhost:8000/ws
